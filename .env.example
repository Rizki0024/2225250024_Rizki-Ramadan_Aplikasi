# =====================================================================
# Contoh konfigurasi. JANGAN isi nilai asli di file ini.
# Salin bagian yang relevan ke:
#   backend/.env    (variabel BACKEND)
#   frontend/.env   (variabel FRONTEND)
# File .env sudah diabaikan oleh .gitignore.
# =====================================================================

# ---------- BACKEND (backend/.env atau Environment di Render) ----------
# URL proyek Supabase, mis. https://abcdefgh.supabase.co
# Kosongkan SUPABASE_URL & SUPABASE_SECRET_KEY untuk memakai mode lokal (JSON).
SUPABASE_URL=
# Secret key (sb_secret_...) atau service_role key. RAHASIA — hanya di backend.
SUPABASE_SECRET_KEY=
# Kunci penandatangan token login siswa. RAHASIA, acak, minimal 32 karakter.
# Buat dengan: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Masa berlaku token (jam)
TOKEN_TTL_HOURS=8
# Domain frontend yang diizinkan (pisahkan dengan koma, tanpa / di akhir)
ALLOWED_ORIGINS=http://localhost:5173
# Durasi evaluasi (menit)
EVALUATION_MINUTES=30

# Guru virtual (opsional). Kosongkan ANTHROPIC_API_KEY untuk mode "curated" yang gratis.
# RAHASIA — hanya di backend. Lihat docs/realtime-voice.md untuk perkiraan biaya.
ANTHROPIC_API_KEY=
# Model Claude untuk tutor (bawaan claude-opus-5-5 ≈ US$0,015/pertanyaan;
# claude-haiku-5-5 ≈ US$0,0006/pertanyaan, jauh lebih murah). Diisi di Environment Variables Vercel (backend).
TUTOR_MODEL=claude-opus-5-5
# Guru virtual GRATIS via Groq (opsional, tanpa kartu kredit): buat kunci di console.groq.com → API Keys.
# RAHASIA — hanya di backend. Dipakai setelah Claude (bila ada); bila kuota gratis habis → jawaban siap pakai.
GROQ_API_KEY=
# Urutan model Groq (dipisah koma). Kosongkan untuk bawaan: openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
GROQ_MODELS=
# Batas pertanyaan ke guru virtual per siswa per 10 menit
TUTOR_MAX_REQUESTS=30

# ---------- FRONTEND (frontend/.env atau Environment di Vercel) ----------
# Alamat backend FastAPI. BUKAN rahasia (terlihat oleh browser).
VITE_API_URL=http://localhost:8000
